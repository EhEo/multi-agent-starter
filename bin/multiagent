#!/usr/bin/env bash
# multiagent — initialize a MultiAgent workspace and optionally open a tmux layout.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GENERATOR="$REPO_ROOT/plugins/multi-agent-starter/skills/configure-multiagent/generator/init.py"

usage() {
  cat <<'EOF'
usage: multiagent [tmux] [-claude|-codex] [--target DIR] [options]

Subcommands:
  (없음)        시스템 파일을 초기화(또는 검증)하고 claude/codex를 직접 실행한다.
  tmux          시스템 파일을 초기화한 뒤 tmux 레이아웃을 연다 (왼쪽: claude, 오른쪽: mat).

Flavor:
  -claude, --claude   Claude Code를 오케스트레이터로 사용한다 (기본값).
  -codex,  --codex    Codex를 오케스트레이터로 사용한다.

Options:
  --target DIR      현재 폴더 대신 DIR에 시스템을 초기화/실행한다.
  --setup-only      파일 초기화와 mat 헬퍼만 설치하고 종료한다.
  --install-mat     mat 바이너리만 설치하고 종료한다.
  --no-mat          (tmux 서브커맨드) mat 창을 열지 않는다.
  --no-install-mat  mat 자동 설치를 시도하지 않는다.
  --no-install-deps jq 자동 설치를 시도하지 않는다.
  -h, --help        이 도움말을 표시한다.

Examples:
  multiagent                       # claude 시작 (tmux 없음)
  multiagent -codex                # codex 시작 (tmux 없음)
  multiagent tmux                  # claude + mat tmux 레이아웃
  multiagent tmux -codex           # codex + mat tmux 레이아웃
  multiagent tmux --no-mat         # claude tmux (mat 창 없음)
  multiagent --target ~/my-project # 특정 폴더에서 claude 시작
  multiagent --install-mat         # mat 바이너리 설치
  multiagent --setup-only          # 파일만 생성, 실행 없음
EOF
}

say() { printf 'multiagent: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
mat_path() {
  if have mat; then
    command -v mat
    return 0
  fi
  if [ -x "$HOME/.local/bin/mat" ]; then
    printf '%s\n' "$HOME/.local/bin/mat"
    return 0
  fi
  return 1
}

abs_dir() {
  local dir="$1"
  mkdir -p "$dir"
  cd "$dir" && pwd
}

slug() {
  printf '%s' "$1" | tr -c '[:alnum:]_' '-' | sed -E 's/^-+|-+$//g; s/-+/-/g'
}

ensure_on_path_hint() {
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) say "installed to $HOME/.local/bin. Add it to PATH if your shell cannot find mat." ;;
  esac
}

setup_mat_for_target() {
  local target="$1"
  mkdir -p "$target/_local/bin"
  cat >"$target/_local/mat.env" <<EOF
# Generated by multiagent. Kept in _local because it is machine-specific.
export MAT_ROOT="$target"
EOF
  cat >"$target/_local/bin/mat-here" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$ROOT/_local/mat.env" ]; then
  # shellcheck disable=SC1091
  . "$ROOT/_local/mat.env"
fi

: "${MAT_ROOT:=$ROOT}"
export MAT_ROOT

pick_task() {
  find "$MAT_ROOT/tasks" -mindepth 2 -maxdepth 2 -name task.md -type f -printf '%T@ %h\n' 2>/dev/null \
    | sort -nr \
    | sed -n '1s#^[^ ]* .*/##p'
}

if [ "$#" -eq 0 ]; then
  for _ in 1 2 3 4 5; do
    task="$(pick_task || true)"
    if [ -n "${task:-}" ]; then
      set -- "$task"
      break
    fi
    sleep 1
  done
fi

if command -v mat >/dev/null 2>&1; then
  exec mat "$@"
fi

if [ -x "$HOME/.local/bin/mat" ]; then
  exec "$HOME/.local/bin/mat" "$@"
fi

printf '%s\n' "mat is not installed." >&2
printf '%s\n' "Run: multiagent --install-mat" >&2
exit 127
EOF
  chmod +x "$target/_local/bin/mat-here"
}

install_go_with_apt() {
  have apt || return 1
  have sudo || return 1
  say "go is missing; installing golang-go with apt."
  sudo apt update
  sudo apt install -y golang-go
}

install_mat() {
  local existing
  if existing="$(mat_path)"; then
    say "mat already installed: $existing"
    return 0
  fi

  if have brew; then
    say "installing mat with Homebrew."
    brew install netwaif/tap/mat
    return 0
  fi

  if ! have go; then
    install_go_with_apt || die "cannot install mat automatically: brew/go missing and apt+sudo unavailable."
  fi

  have go || die "go is still unavailable after install attempt."
  mkdir -p "$HOME/.local/bin"
  say "installing mat with go install."
  GOBIN="$HOME/.local/bin" go install github.com/netwaif/mat@latest
  ensure_on_path_hint
}

install_jq() {
  if have jq; then
    say "jq already installed: $(command -v jq)"
    return 0
  fi

  if have brew; then
    say "installing jq with Homebrew."
    brew install jq
    return 0
  fi

  if have apt && have sudo; then
    say "jq is missing; installing jq with apt."
    sudo apt update
    sudo apt install -y jq
    return 0
  fi

  die "cannot install jq automatically: brew unavailable and apt+sudo unavailable."
}

tmux_send() {
  local target="$1"
  shift
  tmux send-keys -t "$target" "$*" C-m
}

# ── 서브커맨드 감지 ───────────────────────────────────────────────────────────
SUBCOMMAND=""
if [ "${1:-}" = "tmux" ]; then
  SUBCOMMAND="tmux"
  shift
fi

# ── 옵션 파싱 ─────────────────────────────────────────────────────────────────
FLAVOR="claude"
TARGET="."
OPEN_MAT=1
AUTO_INSTALL_MAT=1
AUTO_INSTALL_DEPS=1
INSTALL_MAT_ONLY=0
SETUP_ONLY=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    -claude|--claude)
      FLAVOR="claude"
      shift
      ;;
    -codex|--codex)
      FLAVOR="codex"
      shift
      ;;
    --target)
      [ "${2:-}" ] || die "--target requires a directory."
      TARGET="$2"
      shift 2
      ;;
    --install-mat)
      INSTALL_MAT_ONLY=1
      shift
      ;;
    --setup-only)
      SETUP_ONLY=1
      shift
      ;;
    --no-mat)
      OPEN_MAT=0
      shift
      ;;
    --no-install-mat)
      AUTO_INSTALL_MAT=0
      shift
      ;;
    --no-install-deps)
      AUTO_INSTALL_DEPS=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

# ── mat 단독 설치 ─────────────────────────────────────────────────────────────
if [ "$INSTALL_MAT_ONLY" -eq 1 ]; then
  install_mat
  exit 0
fi

# ── 공통 사전 점검 ────────────────────────────────────────────────────────────
have python3 || die "python3 is required."
[ -f "$GENERATOR" ] || die "generator not found: $GENERATOR"

if [ "$FLAVOR" = "claude" ]; then
  have claude || die "claude command not found."
  MAIN_CMD="claude"
else
  have codex || die "codex command not found."
  MAIN_CMD="codex"
fi

TARGET="$(abs_dir "$TARGET")"
python3 "$GENERATOR" --flavor "$FLAVOR" --target "$TARGET" --yes

if [ "$SETUP_ONLY" -eq 1 ]; then
  setup_mat_for_target "$TARGET"
  say "project initialized: $TARGET"
  say "mat helper: $TARGET/_local/bin/mat-here"
  exit 0
fi

# ── 분기: tmux 서브커맨드 ─────────────────────────────────────────────────────
if [ "$SUBCOMMAND" = "tmux" ]; then

  have tmux || die "tmux is required for this subcommand. Install tmux first."

  setup_mat_for_target "$TARGET"

  if ! have jq && [ "$AUTO_INSTALL_DEPS" -eq 1 ]; then
    ( install_jq ) || say "jq auto-install failed; worker dispatcher calls may fail."
  fi

  MAT_CMD=""
  if [ "$OPEN_MAT" -eq 1 ]; then
    if ! mat_path >/dev/null && [ "$AUTO_INSTALL_MAT" -eq 1 ]; then
      ( install_mat ) || say "mat auto-install failed."
    fi
    MAT_CMD="sleep 2; \"$TARGET/_local/bin/mat-here\""
  fi

  SESSION="multiagent-$(slug "$(basename "$TARGET")")"
  [ -n "$SESSION" ] || SESSION="multiagent-session"

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    say "attaching existing tmux session: $SESSION"
    exec tmux attach-session -t "$SESSION"
  fi

  tmux new-session -d -s "$SESSION" -c "$TARGET" -n main
  tmux_send "$SESSION:main.0" "cd \"$TARGET\" && $MAIN_CMD"

  if [ "$OPEN_MAT" -eq 1 ]; then
    tmux split-window -h -t "$SESSION:main" -c "$TARGET"
    tmux_send "$SESSION:main.1" "$MAT_CMD"
    tmux select-pane -t "$SESSION:main.0"
  fi

  exec tmux attach-session -t "$SESSION"

# ── 분기: 기본 (tmux 없음) ────────────────────────────────────────────────────
else

  say "running $MAIN_CMD in $TARGET"
  cd "$TARGET"
  exec "$MAIN_CMD"

fi
