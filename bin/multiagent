#!/usr/bin/env bash
# Windows Git Bash에서 MultiAgent 작업창과 mat 모니터창을 tmux로 여는 런처
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GENERATOR="${MULTIAGENT_GENERATOR:-$REPO_ROOT/plugins/multi-agent-starter/skills/configure-multiagent/generator/init.py}"

usage() {
  cat <<'EOF'
usage: multiagent [-claude|-codex] [--target DIR] [--setup-only] [--no-mat] [--mat PATH]

Options:
  -claude       Use Claude as the main coding pane (default).
  -codex        Use Codex as the main coding pane.
  --target DIR  Initialize/open DIR instead of the current directory.
  --setup-only  Initialize project files and local mat helper, then exit.
  --no-mat      Do not open the mat pane.
  --mat PATH    Use a specific native Windows mat.exe path.
  -h, --help    Show this help.
EOF
}

say() { printf 'multiagent: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

require() {
  local cmd="$1"
  local hint="$2"
  have "$cmd" || die "$cmd is required. $hint"
}

abs_posix_dir() {
  local dir="$1"
  mkdir -p "$dir"
  cd "$dir" && pwd -W 2>/dev/null | sed 's#\\#/#g; s#^\([A-Za-z]\):#/\L\1#' || {
    cd "$dir" && pwd
  }
}

win_path() {
  cygpath -w "$1"
}

slug() {
  printf '%s' "$1" | tr -c '[:alnum:]_' '-' | sed -E 's/^-+|-+$//g; s/-+/-/g'
}

find_mat() {
  if [ -n "${MAT_EXE:-}" ] && [ -f "$MAT_EXE" ]; then
    printf '%s\n' "$MAT_EXE"
    return 0
  fi

  if have mat.exe; then
    command -v mat.exe
    return 0
  fi

  if have mat; then
    command -v mat
    return 0
  fi

  local candidates=(
    "$HOME/AppData/Local/Microsoft/WinGet/Packages/mat.exe"
    "/d/GitRepos/mat/mat.exe"
    "/c/tmp/mat/mat.exe"
  )
  local c
  for c in "${candidates[@]}"; do
    if [ -f "$c" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done

  return 1
}

setup_mat_for_target() {
  local target_posix="$1"
  local target_win="$2"
  local mat_exe="${3:-}"

  mkdir -p "$target_posix/_local/bin"
  cat >"$target_posix/_local/mat.env" <<EOF
# Generated by multiagent. Kept in _local because it is machine-specific.
export MAT_ROOT_WIN="$target_win"
export MAT_ROOT="$target_win"
EOF
  if [ -n "$mat_exe" ]; then
    {
      printf 'export MAT_EXE=%q\n' "$mat_exe"
    } >>"$target_posix/_local/mat.env"
  fi

  cat >"$target_posix/_local/bin/mat-here" <<'EOF'
#!/usr/bin/env bash
# 현재 MultiAgent 폴더를 MAT_ROOT로 지정해 native mat을 실행하는 Git Bash 헬퍼
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$ROOT/_local/mat.env" ]; then
  # shellcheck disable=SC1091
  . "$ROOT/_local/mat.env"
fi

if [ -z "${MAT_ROOT:-}" ]; then
  if command -v cygpath >/dev/null 2>&1; then
    MAT_ROOT="$(cygpath -w "$ROOT")"
  else
    MAT_ROOT="$ROOT"
  fi
fi
export MAT_ROOT

pick_task() {
  find "$ROOT/tasks" -mindepth 2 -maxdepth 2 -name task.md -type f -printf '%T@ %h\n' 2>/dev/null \
    | sort -nr \
    | sed -n '1s#^[^ ]* .*/##p'
}

if [ "$#" -eq 0 ]; then
  for _ in 1 2 3 4 5; do
    task="$(pick_task || true)"
    if [ -n "${task:-}" ]; then
      set -- "$task"
      break
    fi
    sleep 1
  done
fi

if [ -n "${MAT_EXE:-}" ] && [ -f "$MAT_EXE" ]; then
  exec "$MAT_EXE" "$@"
fi

if command -v mat.exe >/dev/null 2>&1; then
  exec mat.exe "$@"
fi

if command -v mat >/dev/null 2>&1; then
  exec mat "$@"
fi

printf '%s\n' "mat.exe is not installed or not on PATH." >&2
printf '%s\n' "Build it from D:\\GitRepos\\mat or pass --mat /path/to/mat.exe." >&2
exit 127
EOF
  chmod +x "$target_posix/_local/bin/mat-here"
}

tmux_send() {
  local target="$1"
  shift
  tmux send-keys -t "$target" "$*" C-m
}

FLAVOR="claude"
TARGET="."
OPEN_MAT=1
SETUP_ONLY=0
MAT_EXE=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -claude|--claude)
      FLAVOR="claude"
      shift
      ;;
    -codex|--codex)
      FLAVOR="codex"
      shift
      ;;
    --target)
      [ "${2:-}" ] || die "--target requires a directory."
      TARGET="$2"
      shift 2
      ;;
    --setup-only)
      SETUP_ONLY=1
      shift
      ;;
    --no-mat)
      OPEN_MAT=0
      shift
      ;;
    --mat)
      [ "${2:-}" ] || die "--mat requires a path."
      MAT_EXE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ;;
  *) die "this launcher is for Windows Git Bash/MSYS environments." ;;
esac

require cygpath "Install Git for Windows or run from Git Bash."
require tmux "Install tmux for Git Bash/MSYS2 first."
have python || have python3 || die "python or python3 is required."
[ -f "$GENERATOR" ] || die "generator not found: $GENERATOR"

if have python; then
  PYTHON_BIN="python"
else
  PYTHON_BIN="python3"
fi

if [ "$FLAVOR" = "claude" ]; then
  require claude "Install Claude Code CLI or use -codex."
  MAIN_CMD="claude"
else
  require codex "Install Codex CLI or use -claude."
  MAIN_CMD="codex"
fi

TARGET_POSIX="$(abs_posix_dir "$TARGET")"
TARGET_WIN="$(win_path "$TARGET_POSIX")"

MAT_FOUND=""
if [ "$OPEN_MAT" -eq 1 ]; then
  if MAT_FOUND="$(find_mat)"; then
    :
  else
    say "mat.exe not found. The mat pane will show installation guidance."
  fi
fi

"$PYTHON_BIN" "$GENERATOR" --flavor "$FLAVOR" --target "$TARGET_WIN" --yes
setup_mat_for_target "$TARGET_POSIX" "$TARGET_WIN" "$MAT_FOUND"

if [ "$SETUP_ONLY" -eq 1 ]; then
  say "project initialized: $TARGET_WIN"
  say "mat helper: $TARGET_POSIX/_local/bin/mat-here"
  exit 0
fi

SESSION="multiagent-$(slug "$(basename "$TARGET_POSIX")")"
[ -n "$SESSION" ] || SESSION="multiagent-session"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  say "attaching existing tmux session: $SESSION"
  exec tmux attach-session -t "$SESSION"
fi

tmux new-session -d -s "$SESSION" -c "$TARGET_POSIX" -n main
tmux_send "$SESSION:main.0" "cd \"$TARGET_POSIX\" && $MAIN_CMD"

if [ "$OPEN_MAT" -eq 1 ]; then
  tmux split-window -h -t "$SESSION:main" -c "$TARGET_POSIX"
  tmux_send "$SESSION:main.1" "cd \"$TARGET_POSIX\" && ./_local/bin/mat-here || exec bash"
  tmux select-pane -t "$SESSION:main.0"
fi

tmux attach-session -t "$SESSION"
